{
  "name": "mind-the-dag design tokens",
  "version": "0.2.0",
  "units": "px unless noted; 1 px = 0.5 pt in journal export",
  "grid": 8,
  "font": {
    "family": "Inter",
    "fallback": [
      "system-ui",
      "sans-serif"
    ],
    "license": "SIL Open Font License 1.1",
    "roles": {
      "title": {
        "size": 24,
        "weight": 700,
        "lineHeight": 30
      },
      "section": {
        "size": 14,
        "weight": 700,
        "lineHeight": 20
      },
      "sectionChip": {
        "size": 11,
        "weight": 700
      },
      "station": {
        "size": 13,
        "weight": 600,
        "lineHeight": 18
      },
      "caption": {
        "size": 12,
        "weight": 400,
        "lineHeight": 16
      },
      "fileBanner": {
        "size": 10,
        "weight": 700
      }
    },
    "export": {
      "pdf": "embed-subset",
      "svg": "live-text",
      "svgOptional": "outline"
    }
  },
  "line": {
    "width": 10,
    "pitch": 12,
    "angles": [
      0,
      45,
      90
    ],
    "radius45": 40,
    "radius90": 32,
    "radiusMeasuredAt": "centreline",
    "bundleTurn": "concentric",
    "laneShiftLength": 64,
    "join": "round",
    "cap": "butt",
    "patterns": {
      "dashed": [
        12,
        8
      ],
      "dotted": {
        "dash": [
          2,
          10
        ],
        "cap": "round"
      }
    },
    "maxColoursPerMap": 7
  },
  "station": {
    "outline": 3,
    "fill": "surface",
    "stroke": "ink",
    "step": {
      "shape": "circle",
      "radius": 9
    },
    "shared": {
      "shape": "capsule",
      "width": 18,
      "radius": 9,
      "heightPerExtraLine": 12
    },
    "merge": {
      "shape": "roundedSquare",
      "width": 22,
      "radius": 5,
      "fill": "ink"
    },
    "inactive": {
      "stroke": "inactive",
      "lineOpacity": 0.3
    },
    "optional": {
      "shape": "circle",
      "radius": 9,
      "dash": [
        4.6,
        2.47
      ],
      "label": "muted"
    },
    "junction": {
      "shape": "none"
    }
  },
  "terminus": {
    "overhang": 6,
    "heightRule": "bundle width + 2 × overhang (flag and bar equal)",
    "startFlag": {
      "shape": "pentagon",
      "bodyLength": 6,
      "pointLengthRatio": 0.35,
      "stroke": 3,
      "join": "round",
      "fill": "ink",
      "lineStartsUnderFlag": true
    },
    "stopBar": {
      "width": 6,
      "radius": 2,
      "fill": "ink"
    },
    "iconClearance": 6
  },
  "file": {
    "width": 32,
    "height": 40,
    "radius": 3,
    "fold": 10,
    "foldFill": "ink",
    "stroke": 2.5,
    "banner": {
      "width": 40,
      "height": 14,
      "radius": 3,
      "fill": "ink",
      "text": "surface",
      "case": "lower"
    },
    "stackOffset": 6,
    "stackMax": 3
  },
  "section": {
    "radius": 16,
    "padding": 24,
    "stroke": "none",
    "maxTintsPerMap": 4,
    "chip": {
      "diameter": 20,
      "fill": "ink",
      "text": "surface"
    }
  },
  "label": {
    "clearance": 10,
    "defaultSide": "outer side of the bundle",
    "sameSideAlongRun": true,
    "switchSidesAt": [
      "bend",
      "branch"
    ],
    "onLine": "never",
    "halo": {
      "width": 4,
      "colour": "surface under the label",
      "use": "only where a crossing cannot be avoided"
    }
  },
  "crossing": {
    "angle": 90,
    "awayFrom": [
      "bend",
      "station"
    ],
    "bridgeGap": 4,
    "onTop": "straight-through line"
  },
  "bundleOrder": {
    "scope": "whole map",
    "branchFrom": "own side"
  },
  "rhythm": {
    "evenAlongRun": true,
    "stepMultipleOf": 8,
    "minStep": 64,
    "stepSetBy": "widest label on the run"
  },
  "planned": {
    "style": "cased",
    "wall": 3,
    "core": "surface"
  },
  "legend": {
    "order": "bundle order, top to bottom",
    "then": "shape key",
    "shapeKey": [
      "step",
      "shared",
      "merge",
      "start",
      "stop",
      "planned"
    ],
    "frame": "none",
    "placement": "largest empty corner",
    "minDistanceFromSection": 32
  },
  "titleBlock": {
    "position": "top left",
    "name": "title",
    "meta": "caption (version · date · engine)",
    "logo": {
      "size": 32,
      "align": "right",
      "optional": true
    },
    "journalExport": "omit"
  },
  "export": {
    "background": "transparent",
    "formats": [
      "svg",
      "png",
      "pdf"
    ],
    "png": {
      "dpi": 300
    },
    "journal": {
      "pxToPt": 0.5,
      "textRangePt": [
        5,
        7
      ],
      "columnsMm": {
        "single": 89,
        "oneAndHalf": [
          120,
          136
        ],
        "double": 183
      },
      "maxMapWidthPx": {
        "single": 504,
        "oneAndHalf": [
          680,
          771
        ],
        "double": 1037
      },
      "tooWide": "warn and offer overview + detail split"
    }
  },
  "themes": {
    "light": {
      "ink": "#1A1D21",
      "surface": "#FFFFFF",
      "muted": "#5C636B",
      "inactive": "#B8BEC4",
      "background": "transparent",
      "preview": "#FFFFFF"
    },
    "dark": {
      "ink": "#E8EAED",
      "surface": "#16191D",
      "muted": "#9AA2AA",
      "inactive": "#4A5058",
      "background": "#16191D",
      "lineContrastMin": 3.0
    }
  },
  "palettes": {
    "forest": {
      "description": "nf-core green leads, deep blue and amber follow, ink comes last",
      "lines": [
        {
          "name": "nf-core green",
          "light": "#24B064",
          "dark": "#24B064"
        },
        {
          "name": "Deep blue",
          "light": "#1F6FAE",
          "dark": "#2A75B5"
        },
        {
          "name": "Amber",
          "light": "#D98A2B",
          "dark": "#D98A2B"
        },
        {
          "name": "Brick",
          "light": "#B44A3A",
          "dark": "#BC5040"
        },
        {
          "name": "Sky",
          "light": "#7FC0E6",
          "dark": "#7FC0E6"
        },
        {
          "name": "Mauve",
          "light": "#A8739A",
          "dark": "#A8739A"
        },
        {
          "name": "Ink",
          "light": "#3D4650",
          "dark": "#C9CED4"
        }
      ],
      "tints": {
        "light": [
          "#EEF7F1",
          "#EEF2F6",
          "#FBF3E8",
          "#F2F3F4"
        ],
        "dark": [
          "#1C2621",
          "#1C222A",
          "#2A2419",
          "#22262B"
        ]
      },
      "cvdMinDeltaE": {
        "light": 11,
        "dark": 10
      }
    },
    "graphite": {
      "description": "Ink and green only, extended with dash patterns; for print and strict journals",
      "lines": [
        {
          "name": "Ink",
          "light": "#1F2328",
          "dark": "#C9CED4"
        },
        {
          "name": "nf-core green",
          "light": "#24B064",
          "dark": "#24B064"
        },
        {
          "name": "Deep green",
          "light": "#0E5F3A",
          "dark": "#2F7D55"
        },
        {
          "name": "Steel",
          "light": "#5B6E80",
          "dark": "#8496A8"
        },
        {
          "name": "Ink dashed",
          "ref": "Ink",
          "pattern": "dashed"
        },
        {
          "name": "Green dashed",
          "ref": "nf-core green",
          "pattern": "dashed"
        },
        {
          "name": "Deep green dotted",
          "ref": "Deep green",
          "pattern": "dotted"
        }
      ],
      "tints": {
        "light": [
          "#F2F3F4",
          "#EDF5F0",
          "#EAECEE"
        ],
        "dark": [
          "#22262B",
          "#1C2621",
          "#212429"
        ]
      },
      "cvdMinDeltaE": {
        "light": 13,
        "dark": 14
      }
    },
    "field": {
      "description": "Earth tones: rust, slate, ochre, plum",
      "lines": [
        {
          "name": "Rust",
          "light": "#92431B",
          "dark": "#AE5A31"
        },
        {
          "name": "Slate",
          "light": "#618EB5",
          "dark": "#618EB5"
        },
        {
          "name": "Ochre",
          "light": "#A58024",
          "dark": "#BC9634"
        },
        {
          "name": "Plum",
          "light": "#7A4E71",
          "dark": "#906387"
        },
        {
          "name": "Moss",
          "light": "#9AB96F",
          "dark": "#9AB96F"
        },
        {
          "name": "Seafoam",
          "light": "#76C2BC",
          "dark": "#76C2BC"
        },
        {
          "name": "Ink",
          "light": "#2E3135",
          "dark": "#E6E1D3"
        }
      ],
      "tints": {
        "light": [
          "#F1F3EC",
          "#EFF3F7",
          "#F6F1E3",
          "#F7EEE9"
        ],
        "dark": [
          "#22251E",
          "#1E232A",
          "#28241A",
          "#2A221E"
        ]
      },
      "cvdMinDeltaE": {
        "light": 15,
        "dark": 10
      }
    }
  },
  "notes": {
    "darkTints": "Dark section tints are provisional; not yet reviewed on the design canvas.",
    "cvd": "Minimum pairwise ΔE in CAM02-UCS (colorspacious) across normal vision and full-severity deuteranomaly, protanomaly and tritanomaly simulation."
  }
}
